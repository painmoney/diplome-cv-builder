# ============================================================
# CV Builder — Environment Variables
# ============================================================
# This file is tracked in Git. NEVER put real values here.
# Copy to .env and fill in actual values for local development.
#
# PUBLIC CLIENT VARIABLES (included in browser bundle)
# These are NOT secrets — they are visible to users.
# Security depends on Supabase RLS policies, not key secrecy.
# ============================================================

# Supabase project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (NOT the service-role key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================================
# SERVER / DEPLOYMENT SECRETS (never committed)
# ============================================================
# These are used only by:
#   - Supabase CLI (linked project)
#   - Integration tests (SUPABASE_SERVICE_ROLE_KEY)
#   - Edge Functions (GITHUB_TOKEN via Function secrets)
#
# Store in:
#   - .env (local, gitignored)
#   - GitHub Actions secrets
#   - Supabase Edge Function secrets
# ============================================================

# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx  (for Edge Functions)
