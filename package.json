{
  "name": "cv-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "env:check": "node scripts/validate-env.mjs --mode development",
    "staging:guard": "node scripts/verify-staging-target.mjs",
    "env:check:staging": "node scripts/validate-env.mjs --mode staging",
    "dev:staging": "npm run staging:guard && VITE_SUPABASE_URL=https://jerwfvhpoanoukxiyvwq.supabase.co vite --port 5199 --strictPort",
    "build:staging": "npm run staging:guard && npm run env:check:staging && vite build --mode staging",
    "db:staging:status": "node scripts/supabase/safe-remote.mjs target-status --target staging",
    "db:staging:migrations": "node scripts/supabase/safe-remote.mjs migration-list --target staging",
    "db:staging:dry-run": "node scripts/supabase/safe-remote.mjs push-dry-run --target staging",
    "db:staging:push": "node scripts/supabase/safe-remote.mjs push-staging --target staging",
    "db:primary:status": "node scripts/supabase/safe-remote.mjs target-status --target primary",
    "db:primary:migrations": "node scripts/supabase/safe-remote.mjs migration-list --target primary",
    "db:primary:dry-run": "node scripts/supabase/safe-remote.mjs push-dry-run --target primary",
    "safety:scan": "node scripts/supabase/scan-dangerous-commands.mjs",
    "backup:trigger-and-sync": "node scripts/backup/run-and-sync-backup.mjs",
    "backup:sync-latest": "node scripts/backup/sync-latest-backup.mjs",
    "backup:list": "gh run list --workflow supabase-backup-baseline.yml --branch production-development --limit 10"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.18.0",
    "@react-pdf/renderer": "^4.3.2",
    "@supabase/supabase-js": "^2.75.0",
    "docx": "^8.5.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.27.0",
    "html2canvas": "^1.4.1",
    "pako": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.7",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.15",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.106.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
